rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    // L'account base@admin.com va creato in Firebase Authentication prima di andare online.
    function isAdmin() { return signedIn() && request.auth.token.email == 'base@admin.com'; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    function validName(value) { return value is string && value.size() > 0 && value.size() <= 60; }

    function profileActive(uid) {
      let path = /databases/$(database)/documents/profiles/$(uid);
      return exists(path) && get(path).data.get('blocked', false) != true;
    }
    function eventOpen(eventId) {
      let event = get(/databases/$(database)/documents/events/$(eventId)).data;
      return event.status == 'published' && event.endAt > request.time;
    }

    match /profiles/{uid} {
      allow read: if isAdmin() || isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['uid', 'firstName', 'lastName', 'fullName', 'email', 'createdAt'])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && validName(request.resource.data.firstName)
        && validName(request.resource.data.lastName)
        && request.resource.data.createdAt == request.time;
      allow update: if (isOwner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['firstName', 'lastName', 'fullName']))
        || (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['blocked', 'blockedAt']));
      allow delete: if isAdmin();
    }

    // Eventi: pubblici solo se pubblicati, scrivibili solo dall'admin.
    match /events/{eventId} {
      allow read: if isAdmin() || resource.data.status == 'published';
      allow write: if isAdmin();
    }

    // Locandine (JPEG compresso in base64), separate dagli eventi per non appesantire le liste.
    match /posters/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Un ticket per coppia evento/membro: id = <eventId>_<uid>.
    // Il membro lo crea una sola volta (stato 'issued'); solo l'admin lo convalida o lo elimina.
    match /tickets/{ticketId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'eventId', 'code', 'status', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && ticketId == request.resource.data.eventId + '_' + request.auth.uid
        && request.resource.data.status == 'issued'
        && request.resource.data.code is string && request.resource.data.code.matches('^[A-Z0-9]{24}$')
        && request.resource.data.createdAt == request.time
        && profileActive(request.auth.uid)
        && eventOpen(request.resource.data.eventId);
      allow update, delete: if isAdmin();
    }
  }
}
